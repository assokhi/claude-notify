{
  "name": "notify-sounds",
  "description": "Plays a sound when Claude asks a question / needs input (Notification) and when Claude finishes a turn (Stop). Cross-platform: macOS, Windows, Linux.",
  "version": "1.0.1",
  "author": { "name": "assokhi" },
  "keywords": ["notification", "sound", "hooks", "audio", "alert"],
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/play.js\" notification",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/play.js\" complete",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
