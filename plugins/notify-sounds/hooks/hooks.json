{
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/play.js", "notification"],
          "async": true
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "node",
          "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/play.js", "complete"],
          "async": true
        }
      ]
    }
  ]
}
